# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.

# Admin paneline (/admin) giriş şifresi.
ADMIN_PASSWORD=degistir-beni

# Test sonuçlarının saklandığı veritabanı (Vercel panelinden oluşturulur).
# Tanımlı değilse yerelde data/results.json kullanılır, production'da kayıt kapalı kalır.
POSTGRES_URL=

# Sonuç paketlerini imzalamak için kullanılan gizli anahtar.
# Production'da mutlaka tanımlanmalıdır (ör. `openssl rand -base64 32` çıktısı).
RESULT_SIGNING_SECRET=
